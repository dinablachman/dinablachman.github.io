---
/** Classic sun ↔ moon morph (toggles.dev). State comes only from html[data-theme]. */
const clipId = `classic-clip-${Math.random().toString(36).slice(2, 8)}`;
const rays = [
  'M12 1.4v2.4',
  'm20.3 3.7-2.5 2.5',
  'M22.6 12h-2.4',
  'M12 22.6v-2.4',
  'M1.4 12h2.4',
  'm20.3 20.3-2.5-2.5',
  'm3.7 20.3 2.5-2.5',
  'm3.7 3.7 2.5 2.5',
];
---

<button class="theme-toggle" type="button" data-theme-toggle title="Toggle light / night" aria-label="Toggle light / night">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <defs>
      <clipPath id={clipId}>
        <path class="classic-clip" d="M0 0h25a1 1 0 0010 10v14H0Z"></path>
      </clipPath>
    </defs>
    <g stroke="currentColor" stroke-linecap="round">
      <circle class="classic-core" cx="12" cy="12" r="5" fill="currentColor" clip-path={`url(#${clipId})`}></circle>
      {
        rays.map((d) => (
          <path
            class="classic-ray"
            d={d}
            fill="none"
            stroke-width="2"
            stroke-linejoin="round"
            stroke-miterlimit="0"
            paint-order="stroke markers fill"
          />
        ))
      }
    </g>
  </svg>
</button>
