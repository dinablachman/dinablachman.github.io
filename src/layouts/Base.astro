---
import { ClientRouter } from 'astro:transitions';
import MenuBar from '../components/MenuBar.astro';
import MacWindow from '../components/MacWindow.astro';
import WallpaperDialog from '../components/WallpaperDialog.astro';
import '../styles/global.css';

interface Props {
  /** document title (page part) */
  title: string;
  description?: string;
  /** which nav button is active */
  current: 'now' | 'about' | 'projects' | 'blog' | null;
  /** home is the small window; every other tab shares the large one */
  size?: 'small' | 'large';
}

const {
  title,
  description = 'dina blachman — cs & philosophy at barnard. small useful tools, generative models, human agency.',
  current,
  size = current === 'now' ? 'small' : 'large',
} = Astro.props;

const siteName = 'dina blachman';
const pageTitle = title === siteName ? title : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="preload" href="/assets/fonts/mac/ChicagoFLF.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/mac/PixelOperator.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter />
  </head>
  <body>
    <MenuBar transition:persist="menubar" />

    <div class="desktop" data-size={size}>
      <MacWindow size={size}>
        <slot />
      </MacWindow>
    </div>
    <WallpaperDialog />

    <script>
      import { initMacScrollbar } from '../scripts/mac-scrollbar';
      import { zoomWindow } from '../scripts/window-zoom';
      import { initClockTemp } from '../scripts/clock-temp';

      initClockTemp();
      const scrollbar = initMacScrollbar();

      // --- persisted window swap --------------------------------------------
      // The window element survives client-side navigations (transition:persist),
      // so Astro leaves its contents alone. Pull the new pane children out of the
      // incoming document; if the size changes, animate the frame from the old
      // size to the new one.
      let first: DOMRect | null = null;
      let oldPad = '';
      let resized = false;

      document.addEventListener('astro:before-swap', (e) => {
        const nd: Document = (e as any).newDocument;
        const win = document.querySelector<HTMLElement>('.window');
        const newWin = nd.querySelector<HTMLElement>('.window');
        const desk = document.querySelector<HTMLElement>('.desktop');
        if (!win || !newWin || !desk) return;

        first = win.getBoundingClientRect();
        oldPad = getComputedStyle(desk).paddingTop;
        resized = win.dataset.size !== newWin.dataset.size;
        win.dataset.size = newWin.dataset.size;

        const pane = win.querySelector<HTMLElement>('[data-pane]');
        const newPane = newWin.querySelector<HTMLElement>('[data-pane]');
        if (pane && newPane) {
          pane.replaceChildren(...Array.from(newPane.childNodes).map((n) => document.adoptNode(n)));
          pane.scrollTop = 0;
        }
      });

      document.addEventListener('astro:after-swap', () => {
        const win = document.querySelector<HTMLElement>('.window');
        const desk = document.querySelector<HTMLElement>('.desktop');
        if (!win || !desk) return;
        // the scroll target may have changed (whole pane vs. the blog's document)
        scrollbar?.rebind();

        if (resized && first) {
          zoomWindow(win, desk, first, oldPad).then(() => scrollbar?.refresh());
        }
        first = null;
        resized = false;
        requestAnimationFrame(() => scrollbar?.refresh());
      });
    </script>
  </body>
</html>
