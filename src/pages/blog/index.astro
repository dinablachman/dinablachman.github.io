---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NavButtons from '../../components/NavButtons.astro';
import TwoPane from '../../components/TwoPane.astro';
import PostDocument from '../../components/PostDocument.astro';
import { listGroups, defaultPost } from '../../lib/entries';

const posts = await getCollection('blog');
const groups = await listGroups();
const open = defaultPost(posts);
---

<Base title="blog" current="blog">
  <NavButtons current="blog" />
  <TwoPane groups={groups} activeKey={open ? `blog:${open.id}` : null}>
    {open ? <PostDocument post={open} /> : <p class="doc-meta">Nothing here yet.</p>}
  </TwoPane>
</Base>
