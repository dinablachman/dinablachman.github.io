---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NavButtons from '../../components/NavButtons.astro';
import TwoPane from '../../components/TwoPane.astro';
import PostDocument from '../../components/PostDocument.astro';
import { listGroups } from '../../lib/entries';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const groups = await listGroups();
---

<Base title={post.data.title} current="blog">
  <NavButtons current="blog" />
  <TwoPane groups={groups} activeKey={`blog:${post.id}`}>
    <PostDocument post={post} />
  </TwoPane>
</Base>
