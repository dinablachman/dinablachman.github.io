---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NavButtons from '../../components/NavButtons.astro';
import { publicFile } from '../../lib/format';

const projects = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="projects" current="projects">
  <NavButtons current="projects" />

  <ul class="gallery">
    {
      projects.map((p, i) => {
        const media = publicFile(p.data.gif) ?? publicFile(p.data.thumb) ?? publicFile(p.data.poster);
        return (
          <li>
            <a class="card" href={`/projects/${p.id}`}>
              <span class="frame">
                {media ? (
                  <img src={media} alt="" loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
                ) : (
                  <span class="empty" aria-hidden="true" />
                )}
              </span>
              <span class="card-title">{p.data.title}</span>
              <span class="card-sub">
                <span class="sub">{p.data.subtitle}</span>
                <span class="small year">{p.data.date.getFullYear()}</span>
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>
</Base>

<style>
  .gallery {
    list-style: none;
    margin: 0;
    padding-top: 14px;
  }
  .empty {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--dither);
  }
  .sub {
    min-width: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .year {
    flex-shrink: 0;
    line-height: var(--leading-body);
  }
</style>
