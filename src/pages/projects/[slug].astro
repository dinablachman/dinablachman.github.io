---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NavButtons from '../../components/NavButtons.astro';
import TwoPane from '../../components/TwoPane.astro';
import ProjectDocument from '../../components/ProjectDocument.astro';
import { listGroups } from '../../lib/entries';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const groups = await listGroups();
---

<Base title={project.data.title} description={project.data.subtitle} current="blog">
  <NavButtons current="blog" />
  <TwoPane groups={groups} activeKey={`project:${project.id}`}>
    <ProjectDocument project={project} />
  </TwoPane>
</Base>
