---
import Base from '../layouts/Base.astro';
import NavButtons from '../components/NavButtons.astro';

const photos = [
  { src: '/assets/images/gallery/01.jpg', alt: 'ILLIT on stage at a concert in LA' },
  { src: '/assets/images/gallery/02.jpg', alt: 'friends building mechanical keyboards on the floor' },
  { src: '/assets/images/gallery/03.jpg', alt: 'group photo with friends in a living room' },
  { src: '/assets/images/gallery/04.jpg', alt: 'beach at dusk from the boardwalk' },
  { src: '/assets/images/gallery/05.jpg', alt: 'The Outsiders on Broadway, from the mezzanine' },
  { src: '/assets/images/gallery/06.jpg', alt: 'Barnard bear mascot with pom-poms on campus' },
  { src: '/assets/images/gallery/07.jpg', alt: 'sunset over the hills from Griffith Park' },
];
---

<Base title="about" current="about">
  <NavButtons current="about" />

  <div class="about section">
    <!-- the frame stretches to the bio's height; the photo is cropped to fit -->
    <div class="frame dither portrait">
      <img
        src="/assets/images/dina.jpg"
        alt="Dina in a white dress in front of a garden fence"
        width="820"
        height="1024"
        loading="eager"
        style="object-position: 50% 18%"
      />
    </div>
    <div class="bio">
      <span class="section-head">Nice to meet you!</span>
      <!-- TODO: write real about me copy -->
      <p>coming soon</p>
    </div>
  </div>

  <div class="rule"></div>

  <div class="section">
    <span class="section-head">My camera roll</span>
    <!-- one row, scrolled sideways; scripts/roll.ts flags the edge that has more photos -->
    <div class="roll" data-roll>
      <ul class="roll-strip" aria-label="my camera roll" tabindex="0" data-roll-strip>
        {
          photos.map((p) => (
            <li class="frame">
              <img src={p.src} alt={p.alt} width="200" height="150" loading="lazy" decoding="async" />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Base>

<style>
  .about {
    flex-direction: row;
    gap: 22px;
    align-items: stretch;
    padding: 16px 0 14px;
  }
  .portrait {
    width: 132px;
    align-self: stretch;
  }
  .bio {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  .bio p {
    margin: 0;
  }
  /* --shot-w is the tile width; at 148px all seven fit the large window's pane
     (1126px), so the row only overflows once there are more photos or less room */
  .roll {
    position: relative;
    --shot-w: 148px;
    --fade-w: 36px;
  }
  .roll-strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 10px;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .roll-strip::-webkit-scrollbar {
    display: none;
  }
  .roll-strip li {
    width: var(--shot-w);
    aspect-ratio: 4 / 3;
  }
  /* the photos dissolve into the paper on an edge that still has more behind it.
     z-index clears the tiles, which are positioned (.frame) and would paint over
     the start fade; the window's `contain` keeps it out of the rest of the UI. */
  .roll::before,
  .roll::after {
    content: '';
    position: absolute;
    z-index: 1;
    top: 0;
    bottom: 0;
    width: var(--fade-w);
    opacity: 0;
    pointer-events: none;
  }
  .roll::before {
    left: 0;
    background: linear-gradient(to right, var(--paper), transparent);
  }
  .roll::after {
    right: 0;
    background: linear-gradient(to left, var(--paper), transparent);
  }
  .roll[data-more-start]::before,
  .roll[data-more-end]::after {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .roll-strip {
      scroll-behavior: smooth;
    }
    .roll::before,
    .roll::after {
      transition: opacity 120ms linear;
    }
  }
  @media (max-width: 720px) {
    .about {
      flex-direction: column;
    }
    .portrait {
      width: 132px;
      height: 164px;
      align-self: flex-start;
    }
  }
</style>

<script>
  import { initRoll } from '../scripts/roll';

  // the pane's children are replaced on a client-side navigation, so bind again each time
  let stop: (() => void) | null = null;
  const mount = () => {
    stop?.();
    stop = initRoll();
  };
  mount();
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', () => {
    stop?.();
    stop = null;
  });
</script>
